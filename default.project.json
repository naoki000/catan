{
  "name": "Hexland",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.55, 0.55, 0.55],
        "Brightness": 2,
        "ClockTime": 13,
        "GlobalShadows": true
      }
    }
  }
}
